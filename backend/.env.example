# 复制为 backend/.env；系统环境变量优先于此文件。
APP_NAME=墨记后端
APP_ENV=development
HOST=127.0.0.1
PORT=8000
# PyCharm 断点调试保持 false；需要保存后自动重启时改为 true。
RELOAD=false
LOG_LEVEL=INFO
# 浏览器跨域白名单，使用 JSON 数组；微信小程序请求无需 CORS。
CORS_ORIGINS=[]

# 开发从本地直连 z11 服务。
# 真实配置保存在不提交的 backend/.env；此处留空也能启动独立框架。
# DATABASE_URL=postgresql+asyncpg://keeping_accounts_dev_app:<encoded-password>@47.251.103.11:15432/keeping_accounts_dev
DATABASE_URL=
# REDIS_URL=redis://:<encoded-password>@47.251.103.11:16379/1
REDIS_URL=
REDIS_KEY_PREFIX=moji:dev:
# 完成真实连接配置后设为 true，启动时检查 PostgreSQL 和 Redis。
# 检查失败则停止启动，不自动建表或执行迁移。
CHECK_CONNECTIONS_ON_STARTUP=false

# 微信 AppSecret 只填写在本地 .env，禁止提交或写入前端。
WECHAT_APP_ID=wx0f90babab478b2b6
WECHAT_APP_SECRET=
WECHAT_TIMEOUT_SECONDS=10
# 本项目的登录态有效期，单位为秒，默认 7 天，与微信 session_key 无关。
AUTH_SESSION_TTL_SECONDS=604800
# 每个请求来源 IP 在一分钟内允许的登录次数。
AUTH_LOGIN_RATE_LIMIT=30

# sub2api 模型配置；推理强度在服务端固定为 xhigh。
LLM_BASE_URL=https://api.zf-yun.cn
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_API_MODE=responses
LLM_TIMEOUT_SECONDS=45
# 流式聊天整轮预算，单位为秒；范围 10–240，客户端等待 300 秒。
CHAT_TIMEOUT_SECONDS=240
# V2 预留配置；默认结构化工具循环，真实链路验证后才能显式选择 native。
# V2 路由默认关闭；模型业务联调和前端接入完成后再单独启用。
CHAT_V2_ENABLED=false
CHAT_V2_TOOL_MODE=structured
CHAT_V2_MAX_TOOL_CALLS=6
CHAT_V2_MAX_MODEL_REQUESTS=6
CHAT_V2_MAX_RANGE_DAYS=366
# 模型历史输入的 JSON 字符预算及最近完整问答轮数；不代表 token 数。
CHAT_V2_CONTEXT_MAX_CHARS=16000
CHAT_V2_CONTEXT_RECENT_TURNS=6
# V2 整次模型请求、工具结果及响应读取上限；字符数不是 token 数。
CHAT_V2_MAX_INPUT_CHARS=220000
CHAT_V2_MAX_TOOL_RESULT_CHARS=60000
CHAT_V2_MAX_TOOL_OUTPUT_CHARS=160000
CHAT_V2_MAX_RESPONSE_BYTES=262144
CHAT_V2_MAX_OUTPUT_TOKENS=12000
# V2 分页签名专用密钥，至少 32 字符；启用分页前配置，各环境独立，不复用其他密钥。
CHAT_V2_CURSOR_SECRET=

# 共享邀请专用签名密钥，至少 32 字符；各环境独立配置，不提交真实值。
BOOK_INVITE_SECRET=

# Web 管理端独立账号；先运行 python admin_password.py 生成 Argon2 摘要。
# 未配置摘要时禁止管理员登录；不设置任何默认密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_ORIGIN=http://127.0.0.1:5174
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_RATE_LIMIT=5
