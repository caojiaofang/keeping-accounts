# 复制为 .env.production，填写真实凭据；此文件不应提交真实密钥。
# 复用 z11 的 app_net 网络与现有数据库容器。
APP_NAME=墨记后端
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=["https://mjzs.zf-yun.cn"]
DATABASE_URL=postgresql+asyncpg://keeping_accounts_prod_app:<encoded-password>@postgres16:5432/keeping_accounts_prod
REDIS_URL=redis://:<encoded-password>@redis6:6379/2
REDIS_KEY_PREFIX=moji:prod:
CHECK_CONNECTIONS_ON_STARTUP=true
WECHAT_APP_ID=wx0f90babab478b2b6
WECHAT_APP_SECRET=
# 模型密钥仅保存在服务器环境文件，推理强度固定为 xhigh。
LLM_BASE_URL=https://api.zf-yun.cn
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_API_MODE=responses
LLM_TIMEOUT_SECONDS=45
# 流式聊天独立预算，不受普通模型请求的 45 秒限制。
CHAT_TIMEOUT_SECONDS=240
# 共享邀请专用签名密钥，至少 32 字符；变更后原邀请失效。
BOOK_INVITE_SECRET=
# 只信任反向代理的来源 IP；Nginx 容器 IP 变化时同步更新并重建后端容器。
FORWARDED_ALLOW_IPS=10.255.1.2
