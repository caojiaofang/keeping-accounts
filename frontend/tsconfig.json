{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["@dcloudio/types", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["common/**/*.ts", "store/**/*.ts", "components/**/*.vue", "pages/**/*.vue", "App.vue", "env.d.ts", "main.js"],
  "exclude": ["node_modules", "unpackage", "dist"]
}
